{
	"name": "@ezwave/commands",
	"version": "1.0.0",
	"description": "TypeScript Z-Wave: auto-generated Z-Wave command classes",
	"repository": {
		"type": "git",
		"url": "https://github.com/poelstra/ezwave/tree/main/libraries/commands"
	},
	"author": "Martin Poelstra <martin@beryllium.net>",
	"license": "MIT",
	"main": "lib/generated/index.js",
	"typings": "lib/generated/index.d.ts",
	"scripts": {
		"build": "rm -rf src/generated/ && tsx src/generator/generate_commands.ts && tsc",
		"watch": "tsc --watch",
		"lint": "eslint src",
		"test": "vitest run"
	},
	"keywords": [
		"zwave",
		"z-wave",
		"typescript"
	],
	"dependencies": {
		"@ezwave/shared": "workspace:*",
		"@ezwave/spec": "workspace:*",
		"@ezwave/codec": "workspace:*"
	},
	"devDependencies": {
		"@ezwave/build-config": "workspace:*",
		"eslint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"tsx": "catalog:",
		"@types/node": "catalog:",
		"async-main": "^1.0.2",
		"case": "^1.6.3",
		"source-map-support": "^0.5.21"
	}
}
