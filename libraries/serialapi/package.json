{
	"name": "@ezwave/serialapi",
	"version": "1.0.0",
	"description": "TypeScript Z-Wave: SerialAPI library",
	"repository": {
		"type": "git",
		"url": "https://github.com/poelstra/ezwave/tree/main/libraries/serialapi"
	},
	"author": "Martin Poelstra <martin@beryllium.net>",
	"license": "MIT",
	"main": "lib/index.js",
	"typings": "lib/index.d.ts",
	"scripts": {
		"build": "BROWSERSLIST_IGNORE_OLD_DATA=true xstate-codegen 'src/**/*.machine.ts' --once && tsc",
		"watch": "tsc --watch",
		"lint": "eslint src",
		"test": "vitest run"
	},
	"keywords": [
		"zwave",
		"z-wave",
		"typescript"
	],
	"dependencies": {
		"@ezwave/shared": "workspace:*",
		"@ezwave/codec": "workspace:*",
		"@ezwave/spec": "workspace:*",
		"debug": "^4.4.3",
		"xstate": "~4.16.2"
	},
	"devDependencies": {
		"@ezwave/build-config": "workspace:*",
		"@ezwave/test-util": "workspace:*",
		"eslint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/node": "catalog:",
		"sinon": "~9.2.4",
		"@types/sinon": "~9.0.11",
		"@types/debug": "^4.1.13",
		"xstate-codegen": "^0.3.0"
	}
}
