{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["lib/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"watch": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	}
}
